# ====================================================================
# Shree Balaji Food Logistics Platform - Environment Template
# Duplicate this file as '.env' in your root directory.
# ====================================================================

# Port Configuration (Defaults to 3000)
PORT=3000
NODE_ENV=development

# Cloud Supabase Database Credentials (Optional for cloud sync)
# Obtain from your Supabase Dashboard: Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Kitchen Admin & Authentication Configuration
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@shreebalajitiffin.in
ADMIN_RECOVERY_PIN=70077

# Disable Vite HMR when deploying behind reverse proxies
DISABLE_HMR=false
